# --- Database ---
MONGODB_URI=mongodb://127.0.0.1:27017/edumanage

# --- Auth (use a long random string: openssl rand -base64 32) ---
JWT_SECRET=change-me-to-a-long-random-string

# --- Cloudinary (https://cloudinary.com/console) ---
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- WhatsApp Business Cloud API (optional; without these messages are logged but not delivered) ---
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=

# --- Cron protection for /api/cron/reminders ---
CRON_SECRET=change-me
